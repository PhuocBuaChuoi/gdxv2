{
  "session": "gdx-laser",
  "calls": [
    {
      "tool": "run_project",
      "args": {
        "projectPath": "${REPO}",
        "scene": "res://levels/level_04.tscn",
        "engineArgs": ["--resolution", "960x540"],
        "options": { "quiet": true, "session": "gdx-laser" }
      }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 30 }, "session": "gdx-laser" } },
    {
      "tool": "set_property",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "property": "global_position",
        "value": { "x": 1150, "y": 405 },
        "session": "gdx-laser"
      }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 3 }, "session": "gdx-laser" } },
    {
      "tool": "wait_for",
      "args": {
        "condition": { "node": "/root/LevelRoot/Hazards/LaserGate", "property": "is_on", "equals": false },
        "timeoutMs": 6000,
        "session": "gdx-laser"
      }
    },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/RespawnCoordinator",
        "properties": ["attempt_count"],
        "session": "gdx-laser"
      }
    },
    {
      "tool": "set_property",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "property": "global_position",
        "value": { "x": 1150, "y": 405 },
        "session": "gdx-laser"
      }
    },
    {
      "tool": "wait_for",
      "args": {
        "condition": { "node": "/root/LevelRoot/Hazards/LaserGate", "property": "is_on", "equals": true },
        "timeoutMs": 6000,
        "session": "gdx-laser"
      }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 6 }, "session": "gdx-laser" } },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/laser_reactivate.png", "responseMode": "path_only", "session": "gdx-laser" }
    },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "properties": ["global_position", "visible", "control_locked"],
        "session": "gdx-laser"
      }
    },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/RespawnCoordinator",
        "properties": ["attempt_count"],
        "session": "gdx-laser"
      }
    },
    { "tool": "get_errors", "args": { "session": "gdx-laser" } }
  ]
}
