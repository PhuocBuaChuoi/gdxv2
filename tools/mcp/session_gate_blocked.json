{
  "session": "gdx-blocked",
  "calls": [
    {
      "tool": "run_project",
      "args": {
        "projectPath": "${REPO}",
        "scene": "res://levels/level_03.tscn",
        "engineArgs": ["--resolution", "960x540"],
        "options": { "quiet": true, "session": "gdx-blocked" }
      }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 30 }, "session": "gdx-blocked" } },
    {
      "tool": "set_property",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "property": "gravity_direction",
        "value": -1,
        "session": "gdx-blocked"
      }
    },
    {
      "tool": "set_property",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "property": "global_position",
        "value": { "x": 1100, "y": 118 },
        "session": "gdx-blocked"
      }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 20 }, "session": "gdx-blocked" } },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "properties": ["global_position", "gravity_direction"],
        "session": "gdx-blocked"
      }
    },
    { "tool": "simulate_action", "args": { "action": "p1_right", "options": { "mode": "press" }, "session": "gdx-blocked" } },
    { "tool": "wait_for", "args": { "condition": { "frames": 150 }, "session": "gdx-blocked" } },
    { "tool": "simulate_action", "args": { "action": "p1_right", "options": { "mode": "release" }, "session": "gdx-blocked" } },
    { "tool": "wait_for", "args": { "condition": { "frames": 15 }, "session": "gdx-blocked" } },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "properties": ["global_position", "gravity_direction"],
        "session": "gdx-blocked"
      }
    },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/blocked_gate_before.png", "responseMode": "path_only", "session": "gdx-blocked" }
    },
    { "tool": "get_errors", "args": { "session": "gdx-blocked" } }
  ]
}
