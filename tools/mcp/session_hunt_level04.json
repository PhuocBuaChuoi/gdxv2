{
  "session": "gdx-hunt",
  "calls": [
    {
      "tool": "run_project",
      "args": {
        "projectPath": "${REPO}",
        "scene": "res://levels/level_04.tscn",
        "engineArgs": ["--resolution", "960x540"],
        "options": { "quiet": true, "session": "gdx-hunt" }
      }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 40 }, "session": "gdx-hunt" } },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/l4_10_spawn.png", "responseMode": "path_only", "session": "gdx-hunt" }
    },

    {
      "tool": "stress_input",
      "args": {
        "pool": {
          "actions": ["p1_left", "p1_right", "p1_jump", "p1_action", "p2_left", "p2_right", "p2_jump", "p2_action"]
        },
        "count": 150,
        "seed": 7,
        "options": { "gapMs": 16 },
        "session": "gdx-hunt"
      }
    },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/l4_11_fuzz.png", "responseMode": "path_only", "session": "gdx-hunt" }
    },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "properties": ["form", "gravity_direction", "velocity", "global_position"],
        "session": "gdx-hunt"
      }
    },

    {
      "tool": "simulate_action",
      "args": { "action": "p1_right", "options": { "mode": "press" }, "session": "gdx-hunt" }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 45 }, "session": "gdx-hunt" } },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/l4_12_portal_dash.png", "responseMode": "path_only", "session": "gdx-hunt" }
    },
    {
      "tool": "simulate_action",
      "args": { "action": "p1_right", "options": { "mode": "release" }, "session": "gdx-hunt" }
    },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "properties": ["form", "global_position"],
        "session": "gdx-hunt"
      }
    },

    {
      "tool": "simulate_action",
      "args": { "action": "p1_left", "options": { "mode": "press" }, "session": "gdx-hunt" }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 18 }, "session": "gdx-hunt" } },
    {
      "tool": "simulate_action",
      "args": { "action": "p1_left", "options": { "mode": "release" }, "session": "gdx-hunt" }
    },
    {
      "tool": "simulate_action",
      "args": { "action": "p1_right", "options": { "mode": "press" }, "session": "gdx-hunt" }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 18 }, "session": "gdx-hunt" } },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/l4_13_portal_retrigger.png", "responseMode": "path_only", "session": "gdx-hunt" }
    },
    {
      "tool": "simulate_action",
      "args": { "action": "p1_right", "options": { "mode": "release" }, "session": "gdx-hunt" }
    },

    {
      "tool": "simulate_input",
      "args": {
        "events": [
          { "type": "action", "action": "p1_jump", "pressed": true },
          { "type": "action", "action": "p1_jump", "pressed": false },
          { "type": "action", "action": "p1_action", "pressed": true },
          { "type": "wait", "ms": 32 },
          { "type": "action", "action": "p1_action", "pressed": false }
        ],
        "session": "gdx-hunt"
      }
    },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/l4_14_jump_action_overlap.png", "responseMode": "path_only", "session": "gdx-hunt" }
    },

    {
      "tool": "simulate_action",
      "args": { "action": "p1_right", "options": { "mode": "press" }, "session": "gdx-hunt" }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 90 }, "session": "gdx-hunt" } },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/l4_15_approach_laser.png", "responseMode": "path_only", "session": "gdx-hunt" }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 90 }, "session": "gdx-hunt" } },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/l4_16_laser.png", "responseMode": "path_only", "session": "gdx-hunt" }
    },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/RespawnCoordinator",
        "properties": ["attempt_count"],
        "session": "gdx-hunt"
      }
    },
    {
      "tool": "simulate_action",
      "args": { "action": "p1_jump", "options": { "mode": "tap" }, "session": "gdx-hunt" }
    },
    {
      "tool": "simulate_action",
      "args": { "action": "p1_jump", "options": { "mode": "tap" }, "session": "gdx-hunt" }
    },
    {
      "tool": "simulate_action",
      "args": { "action": "p1_action", "options": { "mode": "tap" }, "session": "gdx-hunt" }
    },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/l4_17_respawn.png", "responseMode": "path_only", "session": "gdx-hunt" }
    },
    {
      "tool": "simulate_action",
      "args": { "action": "p1_right", "options": { "mode": "release" }, "session": "gdx-hunt" }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 30 }, "session": "gdx-hunt" } },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/RespawnCoordinator",
        "properties": ["attempt_count"],
        "session": "gdx-hunt"
      }
    },
    { "tool": "get_errors", "args": { "session": "gdx-hunt" } },
    { "tool": "get_debug_output", "args": { "limit": 40, "session": "gdx-hunt" } }
  ]
}
