{
  "session": "gdx-gateopen06",
  "calls": [
    {
      "tool": "run_project",
      "args": {
        "projectPath": "${REPO}",
        "scene": "res://levels/level_06.tscn",
        "engineArgs": ["--resolution", "960x540"],
        "options": { "quiet": true, "session": "gdx-gateopen06" }
      }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 30 }, "session": "gdx-gateopen06" } },
    {
      "tool": "set_property",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "property": "gravity_direction",
        "value": -1,
        "session": "gdx-gateopen06"
      }
    },
    {
      "tool": "set_property",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "property": "global_position",
        "value": { "x": 1250, "y": 118 },
        "session": "gdx-gateopen06"
      }
    },
    {
      "tool": "set_property",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP2",
        "property": "global_position",
        "value": { "x": 1250, "y": 410 },
        "session": "gdx-gateopen06"
      }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 25 }, "session": "gdx-gateopen06" } },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/Mechanisms/MiddleWall",
        "properties": ["global_position", "move_offset"],
        "session": "gdx-gateopen06"
      }
    },
    { "tool": "simulate_action", "args": { "action": "p1_right", "options": { "mode": "press" }, "session": "gdx-gateopen06" } },
    { "tool": "wait_for", "args": { "condition": { "frames": 90 }, "session": "gdx-gateopen06" } },
    { "tool": "simulate_action", "args": { "action": "p1_right", "options": { "mode": "release" }, "session": "gdx-gateopen06" } },
    { "tool": "wait_for", "args": { "condition": { "frames": 20 }, "session": "gdx-gateopen06" } },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "properties": ["global_position", "gravity_direction"],
        "session": "gdx-gateopen06"
      }
    },
    {
      "tool": "take_screenshot",
      "args": {
        "path": ".tmp/mcp/gate_opened_after_06.png",
        "responseMode": "path_only",
        "options": { "overwrite": true },
        "session": "gdx-gateopen06"
      }
    },
    { "tool": "get_errors", "args": { "session": "gdx-gateopen06" } }
  ]
}
