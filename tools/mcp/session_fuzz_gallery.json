{
  "session": "gdx-fuzz",
  "calls": [
    {
      "tool": "run_project",
      "args": {
        "projectPath": "${REPO}",
        "scene": "res://levels/e2e_gallery.tscn",
        "engineArgs": ["--resolution", "960x540"],
        "options": { "quiet": true, "session": "gdx-fuzz" }
      }
    },
    { "tool": "wait_for", "args": { "condition": { "frames": 40 }, "session": "gdx-fuzz" } },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/fz_10_start.png", "responseMode": "path_only", "session": "gdx-fuzz" }
    },
    {
      "tool": "stress_input",
      "args": {
        "pool": { "actions": ["p1_left", "p1_right", "p1_jump", "p1_action"] },
        "count": 200,
        "seed": 11,
        "options": { "gapMs": 30 },
        "session": "gdx-fuzz"
      }
    },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/fz_11_after200.png", "responseMode": "path_only", "session": "gdx-fuzz" }
    },
    { "tool": "get_errors", "args": { "session": "gdx-fuzz" } },
    {
      "tool": "stress_input",
      "args": {
        "pool": { "actions": ["p1_left", "p1_right", "p1_jump", "p1_action", "p2_left", "p2_right", "p2_jump", "p2_action"] },
        "count": 300,
        "seed": 23,
        "options": { "gapMs": 20 },
        "session": "gdx-fuzz"
      }
    },
    {
      "tool": "take_screenshot",
      "args": { "path": ".tmp/mcp/fz_12_after500.png", "responseMode": "path_only", "session": "gdx-fuzz" }
    },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/Players/PlayerP1",
        "properties": ["form", "gravity_direction", "global_position", "velocity", "control_locked"],
        "session": "gdx-fuzz"
      }
    },
    {
      "tool": "inspect_node",
      "args": {
        "node": "/root/LevelRoot/RespawnCoordinator",
        "properties": ["attempt_count", "latest_checkpoint_order"],
        "session": "gdx-fuzz"
      }
    },
    { "tool": "get_errors", "args": { "session": "gdx-fuzz" } },
    { "tool": "get_debug_output", "args": { "limit": 80, "session": "gdx-fuzz" } }
  ]
}
