[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/main_menu.gd" id="1"]
[ext_resource type="PackedScene" path="res://levels/stage_background.tscn" id="2"]
[ext_resource type="Theme" path="res://resources/cyber_theme.tres" id="3_theme"]
[ext_resource type="Texture2D" path="res://assets/sprites/ai_bg_cyber_city.png" id="4_bg_tex"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")
script = ExtResource("1")

[node name="StageBackground" parent="." instance=ExtResource("2")]
custom_texture = ExtResource("4_bg_tex")
dim = 0.72

[node name="BackdropTint" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.02, 0.04, 0.1, 0.45)

[node name="Title" type="Label" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 60.0
offset_bottom = 175.0
theme_override_colors/font_color = Color(0.25, 0.94, 1, 1)
