[connection signal="pressed" from="MenuBox/PlayBtn" to="." method="_on_play_pressed"]
[connection signal="pressed" from="MenuBox/SelectBtn" to="." method="_on_select_pressed"]
[connection signal="pressed" from="MenuBox/SettingsBtn" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="MenuBox/QuitBtn" to="." method="_on_quit_pressed"]
[connection signal="value_changed" from="SettingsPanel/VolumeRow/VolumeSlider" to="." method="_on_volume_changed"]
