# Normalize line endings for text files
* text=auto eol=lf

# GDScript
*.gd text eol=lf
*.gdshader text eol=lf

# Godot project files
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
project.godot text eol=lf
*.cfg text eol=lf

# Web
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf

# Docs
*.md text eol=lf
*.txt text eol=lf

# Binary files — do not mess with line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg binary
*.ico binary
*.wav binary
*.ogg binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.exe binary
*.dll binary
