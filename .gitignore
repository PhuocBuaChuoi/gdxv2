ehthumbs.db
Thumbs.db
desktop.ini

# Editor backups
*~
*.swp
*.swo
*.bak
*.orig

# Godot downloaded ZIP (not part of repo)
godot_*.zip

# Python caches
__pycache__/
*.pyc

# Godot Engine binary folder (local only, not committed)
godot_engine/
artifacts/
.godot-mcp/runtime/
.godot-mcp/sessions/
.godot-mcp/generated/
.godot-mcp/config.json
.godot-mcp/addon-backups/

